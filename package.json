{
  "name": "react-smokey-fluid-cursor",
  "version": "2.2.0",
  "description": "A customizable fluid cursor effect for React & Next.js Apps running on the web. Enhance user experience with smooth, interactive cursor animations. Perfect for modern web designs.",
  "keywords": [
    "react",
    "nextjs",
    "next.js",
    "smokey cursor",
    "fluid cursor",
    "animated cursor",
    "smokey fluid",
    "javascript",
    "typescript",
    "animated smoke cursor",
    "react cursor",
    "cursor effects",
    "custom cursor",
    "react component",
    "next.js cursor"
  ],
  "homepage": "https://faraasat.github.io/react-smokey-fluid-cursor",
  "bugs": {
    "url": "https://github.com/faraasat/react-smokey-fluid-cursor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faraasat/react-smokey-fluid-cursor.git"
  },
  "license": "MIT",
  "author": "Farasat Ali <63093876+faraasat@users.noreply.github.com>",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/faraasat"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "standard-version",
    "prepublishOnly": "npm run typecheck && npm run test -- --run && npm run build",
    "example:dev": "npm run build && npm --prefix example install && npm --prefix example run dev",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.15",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "pngjs": "^7.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "standard-version": "^9.5.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "smokey-fluid-cursor": "^2.1.0"
  }
}
